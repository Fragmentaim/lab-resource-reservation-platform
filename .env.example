# Copy this file to .env before running docker compose.
# All values below are local-demo defaults. Replace every secret before deployment.

MYSQL_DATABASE=lab_booking
MYSQL_USER=lab_user
MYSQL_PASSWORD=lab_password_change_me
MYSQL_ROOT_PASSWORD=root_password_change_me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me

# Cache only the unfiltered home-page resource catalog. Details and slots are
# read from MySQL; hot-slot inventory uses its separate Redis/Lua workflow.
RESOURCE_CACHE_ENABLED=true
RESOURCE_CACHE_TTL_SECONDS=300
RESOURCE_CACHE_DOUBLE_DELETE_DELAY_MILLIS=500

# Point these to an OpenAI-compatible provider or an Ollama instance reachable
# from Docker. The AI service can still start without a configured model; chat
# and embedding calls will then report a degraded dependency state.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
CHAT_MODEL=qwen2.5:7b
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_MODEL=
AGENT_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_THINKING_MODE=
LLM_REASONING_EFFORT=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_CHAT_MODEL=
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30
AI_SERVICE_TOKEN=replace-with-a-long-random-internal-token
MCP_BACKEND_BASE_URL=http://backend:8081
MCP_ACCESS_TOKEN=
MCP_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
USE_LOCAL_EMBEDDING=false
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
ENABLE_EMBEDDING=false
RETRIEVAL_MODE=vector
ENABLE_HYBRID_SEARCH=true
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_KEYWORD_WEIGHT=1.0
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=lab_knowledge_chunks
ELASTICSEARCH_INDEX_ANALYZER=cjk
ELASTICSEARCH_SEARCH_ANALYZER=cjk

CHUNK_SIZE=512
DOCLING_DEVICE=auto
DOCLING_NUM_THREADS=8
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_DO_FORMULA_ENRICHMENT=true
DOCLING_DO_PICTURE_CLASSIFICATION=true
DOCLING_PICTURE_DESCRIPTION_MODE=off
DOCLING_PICTURE_API_URL=
DOCLING_PICTURE_API_KEY=
DOCLING_PICTURE_MODEL=
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=120
DOCUMENT_DOWNLOAD_MAX_BYTES=268435456

JWT_SECRET=replace-with-at-least-32-random-characters
AGENT_MAX_TOOL_CALLS=8
AGENT_RESERVATION_CONFIRMATION_TTL_SECONDS=600
