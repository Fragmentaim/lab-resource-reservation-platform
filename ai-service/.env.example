LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=replace-with-your-api-key
LLM_API_MODE=chat_completions
CHAT_MODEL=qwen2.5:7b
TOOL_CALLING_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Leave blank for generic OpenAI/Ollama routes. For MiniMax-M3 through a
# compatible gateway: LLM_THINKING_MODE=adaptive and LLM_REASONING_EFFORT=max.
LLM_THINKING_MODE=
LLM_REASONING_EFFORT=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_CHAT_MODEL=
LLM_FALLBACK_TOOL_CALLING_MODEL=
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30
AI_SERVICE_TOKEN=replace-with-a-long-random-internal-token

# MCP runs as a per-user sidecar. Keep the JWT in the process environment, never in a tool argument.
MCP_BACKEND_BASE_URL=http://127.0.0.1:8082
MCP_ACCESS_TOKEN=
MCP_REQUEST_TIMEOUT_SECONDS=30

ENABLE_EMBEDDING=true
USE_LOCAL_EMBEDDING=true
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
HF_HUB_CACHE=./.model-cache/huggingface
RETRIEVAL_MODE=vector
ENABLE_HYBRID_SEARCH=true
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_KEYWORD_WEIGHT=1.0
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=lab_knowledge_chunks
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_INDEX_ANALYZER=cjk
ELASTICSEARCH_SEARCH_ANALYZER=cjk

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=lab_knowledge

ENABLE_RERANK=false
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

OCR_ENABLED=true
OCR_PROVIDER=paddle
OCR_DEVICE=cpu
OCR_MODEL_CACHE_DIR=./.model-cache/paddlex
